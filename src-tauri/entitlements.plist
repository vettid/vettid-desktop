<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	The hardened runtime's exception list. scripts/macos-verify.sh compares
	the signed app against THIS file and fails on any difference, so it is
	the one place to add or remove an entitlement.

	Not granted, on purpose: network.client (it matters only under the App
	Sandbox, which is off; outgoing connections need nothing under the hardened
	runtime), allow-jit, allow-unsigned-executable-memory,
	allow-dyld-environment-variables, disable-library-validation (WKWebView
	runs its JIT in Apple's own WebContent process, which has these itself;
	the app has no dylib outside the bundle), network.server (the app
	listens on no socket), files.user-selected.* (no file picker).
	A later keychain-access-groups entry (the macOS Keychain protector)
	needs an embedded provisioning profile: see docs/MACOS-RELEASE.md.
	-->
	<!-- The microphone of the calls (cpal, behind the webrtc feature). -->
	<key>com.apple.security.device.audio-input</key>
	<true/>
	<!-- Video calls (camera capture is still to come, see src/webrtc/mod.rs). -->
	<key>com.apple.security.device.camera</key>
	<true/>
</dict>
</plist>
